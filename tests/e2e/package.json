{
  "name": "@polyg-mcp/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "showcase": "dotenv -e ../../.env -- tsx showcase/showcase-cli.ts",
    "showcase:demo": "dotenv -e ../../.env -- tsx showcase/showcase-cli.ts --demo incident --walkthrough",
    "showcase:interactive": "dotenv -e ../../.env -- tsx showcase/showcase-cli.ts -i -d deployment-incident",
    "clear": "dotenv -e ../../.env -- tsx clear.ts",
    "seed": "dotenv -e ../../.env -- tsx seed.ts",
    "seed:deployment": "dotenv -e ../../.env -- tsx seed.ts deployment-incident",
    "test": "dotenv -e ../../.env -- vitest run",
    "test:watch": "dotenv -e ../../.env -- vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "openai": "^6.17.0"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
